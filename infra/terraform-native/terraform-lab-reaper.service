[Unit]
Description=Expire stale native Terraform Lab sessions
After=terraform-lab-storage.target
Requires=terraform-lab-storage.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/terraform-lab-reaper
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/terraform-lab/sessions /run/terraform-lab/slots /run/lock/terraform-lab-control
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=1024
LimitCORE=0
