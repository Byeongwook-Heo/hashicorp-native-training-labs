#!/usr/bin/env bash
set -euo pipefail

readonly PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
umask 077

readonly APP_USER="vault-lab"
readonly STATE_ROOT="/var/lib/vault-lab/sessions"
readonly RUNTIME_ROOT="/run/vault-lab/slots"
readonly CONTROL_STAGING_ROOT="${RUNTIME_ROOT}/.control"
readonly CONTROL_LOCK_ROOT="/run/lock/vault-lab-control"
readonly SLOT_PATTERN='^s[0-9]{2}$'
readonly SESSION_ID_PATTERN='^[a-f0-9]{32}$'
readonly EXPIRY_PATTERN='^[0-9]{13}$'
readonly ARTIFACT_PATTERN='^[a-z0-9][a-z0-9._-]{0,63}$'
readonly MAX_ARTIFACT_BYTES=16777216
readonly MAX_AUDIT_BYTES=67108864

SLOT_LOCK_FD=
SCOPE_UNIT=
SCOPE_RUNNER_PID=
SCOPE_OPERATION=
SCOPE_STEP=
SCOPE_SLOT=
SCOPE_CLEANED=true
declare -a FROZEN_TERMINALS=()

die() {
  echo "vault-lab-control: $*" >&2
  exit 64
}

require_slot() {
  local slot="${1:-}"
  [[ "$slot" =~ $SLOT_PATTERN ]] || die "invalid slot"
  local number="${slot#s}"
  number=$((10#$number))
  (( number >= 1 && number <= 99 )) || die "slot out of range"
  id "vaultlab-${slot}" >/dev/null 2>&1 || die "slot user is not provisioned"
  id "vaultverify-${slot}" >/dev/null 2>&1 || die "slot verifier is not provisioned"
  id "vaultsvc-${slot}" >/dev/null 2>&1 || die "slot service user is not provisioned"
}

require_step() {
  case "${1:-}" in
    status|auth-list|secrets-list|enable-kv|write-v1|write-v2|read-v1|\
    kv-soft-delete|kv-restore|policy-write|capabilities|limited-token|\
    token-lookup|approle-enable|approle-role|approle-credentials|\
    approle-login|transit-enable|transit-key|transit-encrypt|\
    transit-decrypt|transit-rotate|audit-enable|audit-inspect|deny-drill|\
    revoke-drill|pki-enable|pki-root|pki-role|pki-issue)
      ;;
    *)
      die "unknown curriculum step"
      ;;
  esac
}

slot_loopback_address() {
  local slot="$1"
  local number="${slot#s}"
  number=$((10#$number))
  printf '127.77.0.%d' "$number"
}

acquire_slot_lock() {
  local slot="$1"
  [[ -d "$CONTROL_LOCK_ROOT" && ! -L "$CONTROL_LOCK_ROOT" ]] \
    || die "control lock directory is unavailable"
  exec {SLOT_LOCK_FD}>"${CONTROL_LOCK_ROOT}/${slot}.lock"
  flock -x "$SLOT_LOCK_FD"
}

read_session_binding() {
  local slot="$1"
  local binding_path="${RUNTIME_ROOT}/${slot}/session-id"
  local app_uid group_gid metadata binding
  require_runtime_directory "$slot"
  [[ -f "$binding_path" && ! -L "$binding_path" ]] \
    || die "session binding is missing"
  app_uid="$(id -u "$APP_USER")"
  group_gid="$(getent group "vaultlab-${slot}" | cut -d: -f3)"
  metadata="$(stat -c '%u:%g:%h:%a:%s' -- "$binding_path")"
  [[ "$metadata" == "${app_uid}:${group_gid}:1:640:33" ]] \
    || die "session binding metadata is unsafe"
  IFS= read -r binding <"$binding_path" || die "session binding is unreadable"
  [[ "$binding" =~ $SESSION_ID_PATTERN ]] || die "session binding is invalid"
  printf '%s\n' "$binding"
}

require_session_binding() {
  local slot="$1"
  local expected="${2:-}"
  [[ "$expected" =~ $SESSION_ID_PATTERN ]] || die "expected session binding is invalid"
  [[ "$(read_session_binding "$slot")" == "$expected" ]] \
    || die "stale session binding"
}

read_expiry() {
  local slot="$1"
  local expiry_path="${RUNTIME_ROOT}/${slot}/expires-at"
  local app_uid group_gid metadata expiry
  require_runtime_directory "$slot"
  [[ -f "$expiry_path" && ! -L "$expiry_path" ]] || die "session expiry is missing"
  app_uid="$(id -u "$APP_USER")"
  group_gid="$(getent group "vaultlab-${slot}" | cut -d: -f3)"
  metadata="$(stat -c '%u:%g:%h:%a:%s' -- "$expiry_path")"
  [[ "$metadata" == "${app_uid}:${group_gid}:1:640:14" ]] \
    || die "session expiry metadata is unsafe"
  IFS= read -r expiry <"$expiry_path" || die "session expiry is unreadable"
  [[ "$expiry" =~ $EXPIRY_PATTERN ]] || die "session expiry is invalid"
  printf '%s\n' "$expiry"
}

scoped_units() {
  local kind="$1"
  local slot="$2"
  local unit
  while IFS= read -r unit; do
    [[ "$unit" =~ ^vault-lab-${kind}-${slot}-[a-f0-9]{12}\.service$ ]] \
      || continue
    printf '%s\n' "$unit"
  done < <(
    systemctl list-units \
      --all --full --plain --no-legend \
      "vault-lab-${kind}-${slot}-*.service" |
      awk '{ print $1 }'
  )
}

stop_kind_units() {
  local kind="$1"
  local slot="$2"
  local unit
  while IFS= read -r unit; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
  done < <(scoped_units "$kind" "$slot")
}

stop_scoped_units() {
  local slot="$1"
  stop_kind_units terminal "$slot"
  stop_kind_units exec "$slot"
}

freeze_terminals() {
  local slot="$1"
  local unit active_state
  FROZEN_TERMINALS=()
  while IFS= read -r unit; do
    active_state="$(systemctl show -p ActiveState --value "$unit" 2>/dev/null || true)"
    case "$active_state" in
      inactive|failed|"") continue ;;
      active) ;;
      *)
        thaw_terminals
        return 1
        ;;
    esac
    if ! systemctl freeze "$unit" >/dev/null; then
      thaw_terminals
      return 1
    fi
    FROZEN_TERMINALS+=("$unit")
    if [[ "$(systemctl show -p FreezerState --value "$unit" 2>/dev/null || true)" \
        != "frozen" ]]; then
      thaw_terminals
      return 1
    fi
  done < <(scoped_units terminal "$slot")
}

thaw_terminals() {
  local unit
  for unit in "${FROZEN_TERMINALS[@]}"; do
    systemctl thaw "$unit" >/dev/null 2>&1 || true
  done
  FROZEN_TERMINALS=()
}

require_slot_filesystem() {
  local slot="$1"
  local state_dir="${STATE_ROOT}/${slot}"
  local marker="${state_dir}/.vault-lab-slot"
  local mount_data

  [[ -d "$state_dir" && ! -L "$state_dir" ]] \
    || die "slot filesystem mountpoint is unavailable"
  mount_data="$(findmnt -rn -M "$state_dir" -o TARGET,FSTYPE,OPTIONS)" \
    || die "slot filesystem is not mounted"
  [[ "$mount_data" == "${state_dir} ext4 "* ]] \
    || die "slot filesystem mount is not the expected ext4 target"
  for option in rw nodev nosuid noexec; do
    [[ ",${mount_data#* ext4 }," == *",${option},"* ]] \
      || die "slot filesystem is missing mount option ${option}"
  done
  [[ "$(stat -c '%u:%g:%a' -- "$state_dir")" == "0:0:711" ]] \
    || die "slot filesystem root ownership is invalid"
  [[ -f "$marker" && ! -L "$marker" ]] \
    || die "slot filesystem marker is missing"
  [[ "$(stat -c '%u:%g:%h:%a' -- "$marker")" == "0:0:1:400" ]] \
    || die "slot filesystem marker metadata is invalid"
  [[ "$(<"$marker")" == "vault-lab:${slot}:v1" ]] \
    || die "slot filesystem marker content is invalid"
}

require_runtime_directory() {
  local slot="$1"
  local runtime_dir="${RUNTIME_ROOT}/${slot}"
  local app_uid group_gid

  app_uid="$(id -u "$APP_USER")"
  group_gid="$(getent group "vaultlab-${slot}" | cut -d: -f3)"
  [[ -d /run/vault-lab && ! -L /run/vault-lab \
    && "$(stat -c '%u:%g:%a' /run/vault-lab)" == "0:0:711" ]] \
    || die "runtime root parent metadata is unsafe"
  [[ -d "$RUNTIME_ROOT" && ! -L "$RUNTIME_ROOT" \
    && "$(stat -c '%u:%g:%a' "$RUNTIME_ROOT")" == "0:0:711" ]] \
    || die "runtime root metadata is unsafe"
  [[ -d "$runtime_dir" && ! -L "$runtime_dir" \
    && "$(stat -c '%u:%g:%a' "$runtime_dir")" \
      == "${app_uid}:${group_gid}:2750" ]] \
    || die "slot runtime directory metadata is unsafe"
  [[ -d "$CONTROL_STAGING_ROOT" && ! -L "$CONTROL_STAGING_ROOT" \
    && "$(stat -c '%u:%g:%a' "$CONTROL_STAGING_ROOT")" == "0:0:700" ]] \
    || die "control staging directory metadata is unsafe"
  [[ "$(stat -c %d "$runtime_dir")" == "$(stat -c %d "$CONTROL_STAGING_ROOT")" \
    && "$(stat -c %m "$runtime_dir")" \
      == "$(stat -c %m "$CONTROL_STAGING_ROOT")" ]] \
    || die "runtime and control staging directories cross mount boundaries"
}

reset_slot_subdirectory() {
  local slot="$1"
  local name="$2"
  local mode="$3"
  local owner="${4:-vaultlab-${slot}}"
  local slot_user="vaultlab-${slot}"
  local state_dir="${STATE_ROOT}/${slot}"
  local directory="${state_dir}/${name}"

  case "$name" in
    data|home|tmp) ;;
    *) die "invalid slot subdirectory" ;;
  esac
  if [[ -e "$directory" || -L "$directory" ]]; then
    [[ -d "$directory" && ! -L "$directory" ]] \
      || die "unsafe slot subdirectory"
    [[ "$(stat -c %d -- "$directory")" == "$(stat -c %d -- "$state_dir")" ]] \
      || die "slot subdirectory crosses a filesystem boundary"
    rm -rf --one-file-system -- "$directory"
  fi
  install -d -o "$owner" -g "$slot_user" -m "$mode" "$directory"
}

prepare_slot_locked() {
  local slot="$1"
  local slot_user="vaultlab-${slot}"
  local runtime_dir="${RUNTIME_ROOT}/${slot}"

  stop_scoped_units "$slot"
  systemctl stop "vault-lab@${slot}.service" >/dev/null 2>&1 || true
  systemctl reset-failed "vault-lab@${slot}.service" >/dev/null 2>&1 || true
  require_slot_filesystem "$slot"

  reset_slot_subdirectory "$slot" data 0700 "vaultsvc-${slot}"
  reset_slot_subdirectory "$slot" home 0770
  reset_slot_subdirectory "$slot" tmp 3770 root
  install \
    -o "vaultsvc-${slot}" \
    -g "$slot_user" \
    -m 0640 \
    /dev/null \
    "${STATE_ROOT}/${slot}/tmp/vault-audit.log"

  rm -rf --one-file-system -- "$runtime_dir"
  install -d -o "$APP_USER" -g "$slot_user" -m 2750 "$runtime_dir"
  require_runtime_directory "$slot"
}

prepare_slot() {
  local slot="$1"
  acquire_slot_lock "$slot"
  prepare_slot_locked "$slot"
}

write_expiry_guard() {
  local slot="$1"
  local expected_session="${2:-}"
  local new_expiry="${3:-}"
  local runtime_dir="${RUNTIME_ROOT}/${slot}"
  local expiry_path="${runtime_dir}/expires-at"
  local temporary now maximum_expiry
  [[ "$expected_session" =~ $SESSION_ID_PATTERN ]] \
    || die "expected session binding is invalid"
  [[ "$new_expiry" =~ $EXPIRY_PATTERN ]] || die "new session expiry is invalid"
  now="$(( $(date +%s) * 1000 ))"
  maximum_expiry="$((now + 24 * 60 * 60 * 1000))"
  (( 10#$new_expiry <= maximum_expiry )) || die "new session expiry is too far in the future"

  require_slot_filesystem "$slot"
  acquire_slot_lock "$slot"
  require_runtime_directory "$slot"
  require_session_binding "$slot" "$expected_session"
  temporary="$(mktemp "${CONTROL_STAGING_ROOT}/.${slot}.expires-at.XXXXXX")"
  if ! {
    printf '%s\n' "$new_expiry" >"$temporary"
    chown "$APP_USER:vaultlab-${slot}" "$temporary"
    chmod 0640 "$temporary"
    sync -f "$temporary"
    /usr/bin/python3 -I -S - \
      "$CONTROL_STAGING_ROOT" \
      "$(basename -- "$temporary")" \
      "$runtime_dir" <<'PY'
import os
import stat
import sys

staging_path, source_name, destination_path = sys.argv[1:]
if "/" in source_name or not source_name.startswith(".s"):
    raise SystemExit("unsafe expiry staging name")
directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
source_directory = os.open(staging_path, directory_flags)
destination_directory = os.open(destination_path, directory_flags)
try:
    source = os.stat(
        source_name,
        dir_fd=source_directory,
        follow_symlinks=False,
    )
    destination = os.fstat(destination_directory)
    if (
        not stat.S_ISREG(source.st_mode)
        or source.st_nlink != 1
        or stat.S_IMODE(source.st_mode) != 0o640
        or source.st_uid != destination.st_uid
        or source.st_gid != destination.st_gid
    ):
        raise SystemExit("unsafe expiry staging metadata")
    os.rename(
        source_name,
        "expires-at",
        src_dir_fd=source_directory,
        dst_dir_fd=destination_directory,
    )
    committed = os.stat(
        "expires-at",
        dir_fd=destination_directory,
        follow_symlinks=False,
    )
    if committed.st_dev != source.st_dev or committed.st_ino != source.st_ino:
        raise SystemExit("expiry rename did not commit the staged inode")
    os.fsync(source_directory)
    os.fsync(destination_directory)
finally:
    os.close(destination_directory)
    os.close(source_directory)
PY
  }; then
    rm -f -- "$temporary"
    return 1
  fi
  [[ "$(read_expiry "$slot")" == "$new_expiry" ]] \
    || die "session expiry guard verification failed"
}

reap_slot() {
  local slot="$1"
  local expected_session="${2:-}"
  local expected_expiry="${3:-}"
  local current_session current_expiry now
  [[ "$expected_session" =~ $SESSION_ID_PATTERN ]] \
    || die "expected session binding is invalid"
  [[ "$expected_expiry" =~ $EXPIRY_PATTERN ]] \
    || die "expected session expiry is invalid"

  require_slot_filesystem "$slot"
  acquire_slot_lock "$slot"
  if [[ ! -e "${RUNTIME_ROOT}/${slot}/session-id" \
    && ! -L "${RUNTIME_ROOT}/${slot}/session-id" ]]; then
    return 0
  fi
  if [[ ! -e "${RUNTIME_ROOT}/${slot}/expires-at" \
    && ! -L "${RUNTIME_ROOT}/${slot}/expires-at" ]]; then
    return 0
  fi
  current_session="$(read_session_binding "$slot")"
  [[ "$current_session" == "$expected_session" ]] || return 0
  current_expiry="$(read_expiry "$slot")"
  [[ "$current_expiry" == "$expected_expiry" ]] || return 0
  now="$(( $(date +%s) * 1000 ))"
  (( 10#$current_expiry <= now )) || return 0
  prepare_slot_locked "$slot"
}

new_unit_suffix() {
  local uuid
  IFS= read -r uuid </proc/sys/kernel/random/uuid
  uuid="${uuid//-/}"
  printf '%.12s' "$uuid"
}

