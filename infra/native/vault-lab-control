artifact_contract() {
  local operation="$1"
  local phase="$2"
  local step="$3"
  case "${operation}:${phase}:${step}" in
    verify:pre:policy-write|verify:post:policy-write)
      printf '%s\n' app-read.hcl ;;
    verify:pre:limited-token|verify:post:limited-token)
      printf '%s\n' app-token.json ;;
    verify:pre:token-lookup|verify:post:token-lookup)
      printf '%s\n' app-token.json token-audit.json ;;
    verify:pre:approle-credentials|verify:post:approle-credentials)
      printf '%s\n' role-id secret-id secret-id.json ;;
    verify:pre:approle-login|verify:post:approle-login)
      printf '%s\n' approle-login.json ;;
    verify:pre:transit-encrypt|verify:post:transit-encrypt)
      printf '%s\n' ciphertext ;;
    verify:pre:transit-decrypt|verify:post:transit-decrypt)
      printf '%s\n' ciphertext decrypted.txt ;;
    verify:pre:transit-rotate|verify:post:transit-rotate)
      printf '%s\n' ciphertext-v2 ;;
    verify:pre:audit-inspect|verify:post:audit-inspect)
      printf '%s\n' audit-trace.jsonl ;;
    verify:pre:deny-drill|verify:post:deny-drill)
      printf '%s\n' denied.out deny-proof.json ;;
    verify:pre:revoke-drill|verify:post:revoke-drill)
      printf '%s\n' revoked-token revoked-accessor revoked-proof.json ;;
    verify:pre:pki-issue|verify:post:pki-issue)
      printf '%s\n' api-cert.json ;;

    skip:pre:policy-write|skip:pre:capabilities|\
    skip:pre:approle-role)
      printf '%s\n' app-read.hcl ;;
    skip:pre:limited-token)
      printf '%s\n' app-read.hcl app-token.json ;;
    skip:pre:token-lookup)
      printf '%s\n' app-read.hcl app-token.json token-audit.json ;;
    skip:pre:approle-credentials)
      printf '%s\n' app-read.hcl role-id secret-id.json secret-id ;;
    skip:pre:approle-login)
      printf '%s\n' app-read.hcl role-id secret-id.json secret-id approle-login.json ;;
    skip:pre:transit-encrypt)
      printf '%s\n' ciphertext ;;
    skip:pre:transit-decrypt)
      printf '%s\n' ciphertext decrypted.txt ;;
    skip:pre:transit-rotate)
      printf '%s\n' ciphertext ciphertext-v2 ;;
    skip:pre:audit-inspect)
      printf '%s\n' audit-trace.jsonl ;;
    skip:pre:deny-drill)
      printf '%s\n' app-read.hcl denied.out deny-proof.json ;;
    skip:pre:revoke-drill)
      printf '%s\n' app-read.hcl revoked-token revoked-accessor revoked-proof.json ;;
    skip:pre:pki-issue)
      printf '%s\n' api-cert.json ;;

    skip:post:policy-write|skip:post:capabilities|skip:post:approle-role)
      printf '%s\n' app-read.hcl ;;
    skip:post:limited-token)
      printf '%s\n' app-read.hcl app-token.json ;;
    skip:post:token-lookup)
      printf '%s\n' app-read.hcl app-token.json token-audit.json ;;
    skip:post:approle-credentials)
      printf '%s\n' app-read.hcl role-id secret-id.json secret-id ;;
    skip:post:approle-login)
      printf '%s\n' app-read.hcl role-id secret-id.json secret-id approle-login.json ;;
    skip:post:transit-encrypt)
      printf '%s\n' ciphertext ;;
    skip:post:transit-decrypt)
      printf '%s\n' ciphertext decrypted.txt ;;
    skip:post:transit-rotate)
      printf '%s\n' ciphertext ciphertext-v2 ;;
    skip:post:audit-inspect)
      printf '%s\n' audit-trace.jsonl ;;
    skip:post:deny-drill)
      printf '%s\n' app-read.hcl denied.out deny-proof.json ;;
    skip:post:revoke-drill)
      printf '%s\n' app-read.hcl revoked-token revoked-accessor revoked-proof.json ;;
    skip:post:pki-issue)
      printf '%s\n' api-cert.json ;;
  esac
}

handoff_artifact() {
  local slot="$1"
  local artifact="$2"
  local source_user="$3"
  local target_user="$4"
  local required="$5"
  local state_dir="${STATE_ROOT}/${slot}"
  local artifact_path="${state_dir}/tmp/${artifact}"
  local slot_group="vaultlab-${slot}"
  local source_uid target_uid group_gid metadata size

  [[ "$artifact" =~ $ARTIFACT_PATTERN ]] \
    || { echo "vault-lab-control: unsafe artifact name" >&2; return 1; }
  case "$artifact" in
    root-token|student-token|vault-token|pki-cert.*|pki-key.*|pki-ca.*)
      echo "vault-lab-control: forbidden artifact" >&2
      return 1
      ;;
  esac
  if [[ ! -e "$artifact_path" && ! -L "$artifact_path" ]]; then
    [[ "$required" == "false" ]] && return 0
    echo "vault-lab-control: required artifact is missing" >&2
    return 1
  fi
  [[ -f "$artifact_path" && ! -L "$artifact_path" ]] \
    || { echo "vault-lab-control: artifact is not a regular file" >&2; return 1; }
  source_uid="$(id -u "$source_user")"
  target_uid="$(id -u "$target_user")"
  group_gid="$(getent group "$slot_group" | cut -d: -f3)"
  metadata="$(stat -c '%u:%g:%h:%a' -- "$artifact_path")"
  [[ "$metadata" == "${source_uid}:${group_gid}:1:600" ]] \
    || { echo "vault-lab-control: artifact metadata is unsafe" >&2; return 1; }
  size="$(stat -c %s -- "$artifact_path")"
  (( size <= MAX_ARTIFACT_BYTES )) \
    || { echo "vault-lab-control: artifact is too large" >&2; return 1; }

  chown --no-dereference "${target_uid}:${group_gid}" -- "$artifact_path" \
    || return 1
  chmod 0600 -- "$artifact_path" || return 1
  [[ "$(stat -c '%u:%g:%h:%a' -- "$artifact_path")" \
      == "${target_uid}:${group_gid}:1:600" ]] \
    || { echo "vault-lab-control: artifact handoff verification failed" >&2; return 1; }
}

validate_audit_log_access() {
  local slot="$1"
  local path="${STATE_ROOT}/${slot}/tmp/vault-audit.log"
  local service_user="vaultsvc-${slot}"
  local slot_group="vaultlab-${slot}"
  local uid gid metadata size

  if [[ ! -e "$path" && ! -L "$path" ]]; then
    echo "vault-lab-control: audit log is missing" >&2
    return 1
  fi
  [[ -f "$path" && ! -L "$path" ]] \
    || { echo "vault-lab-control: audit log is not a regular file" >&2; return 1; }
  uid="$(id -u "$service_user")"
  gid="$(getent group "$slot_group" | cut -d: -f3)"
  metadata="$(stat -c '%u:%g:%h:%a' -- "$path")"
  [[ "$metadata" == "${uid}:${gid}:1:640" ]] \
    || { echo "vault-lab-control: audit log metadata is unsafe" >&2; return 1; }
  size="$(stat -c %s -- "$path")"
  (( size <= MAX_AUDIT_BYTES )) \
    || { echo "vault-lab-control: audit log is too large" >&2; return 1; }
}

handoff_phase() {
  local slot="$1"
  local operation="$2"
  local phase="$3"
  local step="$4"
  local source_user target_user required artifact
  local status=0

  if [[ "$phase" == "pre" ]]; then
    source_user="vaultlab-${slot}"
    target_user="vaultverify-${slot}"
    required=false
  else
    source_user="vaultverify-${slot}"
    target_user="vaultlab-${slot}"
    required=true
  fi
  while IFS= read -r artifact; do
    [[ -n "$artifact" ]] || continue
    handoff_artifact \
      "$slot" "$artifact" "$source_user" "$target_user" "$required" \
      || status=1
  done < <(artifact_contract "$operation" "$phase" "$step")

  if [[ "$step" == "audit-inspect" ]]; then
    validate_audit_log_access "$slot" || status=1
  fi
  return "$status"
}

cleanup_command_scope() {
  local status=0
  [[ "$SCOPE_CLEANED" == "false" ]] || return 0
  SCOPE_CLEANED=true
  set +e
  if [[ -n "$SCOPE_UNIT" ]]; then
    systemctl stop "$SCOPE_UNIT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$SCOPE_RUNNER_PID" ]]; then
    kill -TERM "$SCOPE_RUNNER_PID" >/dev/null 2>&1 || true
    wait "$SCOPE_RUNNER_PID" >/dev/null 2>&1 || true
    SCOPE_RUNNER_PID=
  fi
  if [[ -n "$SCOPE_SLOT" && -n "$SCOPE_OPERATION" && -n "$SCOPE_STEP" ]]; then
    handoff_phase "$SCOPE_SLOT" "$SCOPE_OPERATION" post "$SCOPE_STEP" \
      || status=1
  fi
  thaw_terminals
  return "$status"
}

command_signal() {
  exit 143
}

run_command() {
  local slot="$1"
  local expected_session="${2:-}"
  local operation="${3:-}"
  local step="${4:-}"
  shift 4 || die "command requires session, operation, and step"
  [[ "$expected_session" =~ $SESSION_ID_PATTERN ]] \
    || die "expected session binding is invalid"
  [[ "$operation" == "verify" || "$operation" == "skip" ]] \
    || die "command operation must be verify or skip"
  require_step "$step"
  [[ "${1:-}" == "--" ]] || die "command separator is missing"
  shift
  (( $# > 0 )) || die "missing command"

  local slot_user="vaultlab-${slot}"
  local verifier_user="vaultverify-${slot}"
  local unit runner_status cleanup_status=0
  local -a properties=()
  unit="vault-lab-exec-${slot}-$(new_unit_suffix)"
  mapfile -t properties < <(scope_properties "$slot" 30)

  require_slot_filesystem "$slot"
  acquire_slot_lock "$slot"
  require_session_binding "$slot" "$expected_session"
  [[ -s "${RUNTIME_ROOT}/${slot}/root-token" ]] || die "slot is not initialized"
  [[ -s "${RUNTIME_ROOT}/${slot}/address" ]] || die "slot has no address metadata"
  stop_kind_units exec "$slot"
  freeze_terminals "$slot" || die "could not freeze the learner terminal"
  if ! handoff_phase "$slot" "$operation" pre "$step"; then
    handoff_phase "$slot" "$operation" post "$step" >/dev/null 2>&1 || true
    thaw_terminals
    die "artifact handoff failed"
  fi

  SCOPE_UNIT="$unit"
  SCOPE_OPERATION="$operation"
  SCOPE_STEP="$step"
  SCOPE_SLOT="$slot"
  SCOPE_CLEANED=false
  trap command_signal HUP INT TERM
  trap cleanup_command_scope EXIT

  systemd-run \
    --quiet --collect --wait --pipe --service-type=exec \
    "--unit=${unit}" \
    "--uid=${verifier_user}" "--gid=${slot_user}" \
    "${properties[@]}" \
    "--property=LoadCredential=vault-token:${RUNTIME_ROOT}/${slot}/root-token" \
    -- \
    /usr/local/libexec/vault-lab-exec "$slot" "$@" &
  SCOPE_RUNNER_PID=$!
  if wait "$SCOPE_RUNNER_PID"; then
    runner_status=0
  else
    runner_status=$?
  fi
  SCOPE_RUNNER_PID=
  cleanup_command_scope || cleanup_status=$?
  trap - EXIT HUP INT TERM
  (( cleanup_status == 0 )) || return 65
  return "$runner_status"
}

cleanup_terminal_scope() {
  [[ "$SCOPE_CLEANED" == "false" ]] || return 0
  SCOPE_CLEANED=true
  set +e
  if [[ -n "$SCOPE_UNIT" ]]; then
    systemctl stop "$SCOPE_UNIT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$SCOPE_RUNNER_PID" ]]; then
    kill -TERM "$SCOPE_RUNNER_PID" >/dev/null 2>&1 || true
    wait "$SCOPE_RUNNER_PID" >/dev/null 2>&1 || true
    SCOPE_RUNNER_PID=
  fi
}

terminal_signal() {
  exit 143
}

run_terminal() {
  local slot="$1"
  local expected_session="$2"
  local runtime_max="$3"
  local slot_user="vaultlab-${slot}"
  local unit runner_status registered=false terminal_input_fd
  local -a properties=()
  unit="vault-lab-terminal-${slot}-$(new_unit_suffix)"
  mapfile -t properties < <(scope_properties "$slot" "$runtime_max")

  require_slot_filesystem "$slot"
  acquire_slot_lock "$slot"
  require_session_binding "$slot" "$expected_session"
  [[ -s "${RUNTIME_ROOT}/${slot}/student-token" ]] || die "slot is not initialized"
  [[ -s "${RUNTIME_ROOT}/${slot}/port" ]] || die "slot has no port metadata"
  [[ -s "${RUNTIME_ROOT}/${slot}/address" ]] || die "slot has no address metadata"
  stop_kind_units terminal "$slot"

  SCOPE_UNIT="$unit"
  SCOPE_CLEANED=false
  trap terminal_signal HUP INT TERM
  trap cleanup_terminal_scope EXIT

  exec {terminal_input_fd}<&0
  systemd-run \
    --quiet --collect --wait --pipe --service-type=exec \
    "--unit=${unit}" \
    "--uid=${slot_user}" "--gid=${slot_user}" \
    "${properties[@]}" \
    -- \
    /usr/bin/script -qefc "/usr/local/libexec/vault-lab-shell ${slot}" /dev/null \
    <&"$terminal_input_fd" &
  SCOPE_RUNNER_PID=$!
  exec {terminal_input_fd}<&-
  for _ in {1..100}; do
    if [[ "$(systemctl show -p ActiveState --value "$unit" 2>/dev/null || true)" \
        == "active" ]]; then
      registered=true
      break
    fi
    kill -0 "$SCOPE_RUNNER_PID" 2>/dev/null || break
    sleep 0.02
  done
  flock -u "$SLOT_LOCK_FD"
  [[ "$registered" == "true" ]] || {
    cleanup_terminal_scope
    wait "$SCOPE_RUNNER_PID" >/dev/null 2>&1 || true
    die "terminal unit did not start"
  }

  if wait "$SCOPE_RUNNER_PID"; then
    runner_status=0
  else
    runner_status=$?
  fi
  SCOPE_RUNNER_PID=
  cleanup_terminal_scope
  trap - EXIT HUP INT TERM
  return "$runner_status"
}

terminal_count() {
  local slot="$1"
  local count=0
  local unit
  while IFS= read -r unit; do
    [[ -n "$unit" ]] || continue
    count=$((count + 1))
  done < <(scoped_units terminal "$slot")
  printf '%d\n' "$count"
}

probe_learner_port() {
  local slot="$1"
  local slot_user="vaultlab-${slot}"
  local address unit
  local -a properties=()
  address="$(slot_loopback_address "$slot")"
  unit="vault-lab-exec-${slot}-$(new_unit_suffix)"
  mapfile -t properties < <(scope_properties "$slot" 10)
  [[ -x /usr/bin/python3 ]] || die "Python 3 is unavailable"

  acquire_slot_lock "$slot"
  stop_kind_units exec "$slot"
  systemd-run \
    --quiet --collect --wait --pipe --service-type=exec \
    "--unit=${unit}" \
    "--uid=${slot_user}" "--gid=${slot_user}" \
    "${properties[@]}" \
    -- \
    /usr/bin/python3 -c '
import errno
import socket
import sys

server = socket.socket()
try:
    server.bind((sys.argv[1], 820))
except PermissionError:
    sys.exit(0)
except OSError as error:
    sys.exit(0 if error.errno in (errno.EACCES, errno.EPERM) else 2)
else:
    server.close()
    sys.exit(3)
    ' "$address"
}

probe_learner_signal() {
  local slot="$1"
  local slot_user="vaultlab-${slot}"
  local service_pid current_pid unit
  local -a properties=()
  unit="vault-lab-exec-${slot}-$(new_unit_suffix)"
  mapfile -t properties < <(scope_properties "$slot" 10)
  [[ -x /usr/bin/python3 ]] || die "Python 3 is unavailable"
  [[ "$(systemctl show -p ActiveState --value "vault-lab@${slot}.service")" \
      == "active" ]] || die "slot service is not active"
  service_pid="$(
    systemctl show -p MainPID --value "vault-lab@${slot}.service"
  )"
  [[ "$service_pid" =~ ^[0-9]+$ && "$service_pid" -gt 1 ]] \
    || die "slot service PID is invalid"

  acquire_slot_lock "$slot"
  stop_kind_units exec "$slot"
  systemd-run \
    --quiet --collect --wait --pipe --service-type=exec \
    "--unit=${unit}" \
    "--uid=${slot_user}" "--gid=${slot_user}" \
    "${properties[@]}" \
    -- \
    /usr/bin/python3 -c '
import os
import sys

try:
    pid = int(sys.argv[1])
except ValueError:
    sys.exit(4)
if pid <= 1:
    sys.exit(4)
try:
    os.kill(pid, 0)
except PermissionError:
    sys.exit(0)
except ProcessLookupError:
    sys.exit(3)
except OSError:
    sys.exit(5)
else:
    sys.exit(2)
    ' "$service_pid"
  current_pid="$(
    systemctl show -p MainPID --value "vault-lab@${slot}.service"
  )"
  [[ "$current_pid" == "$service_pid" ]] \
    || die "slot service changed during learner signal probe"
}

(( $# >= 2 )) || die "usage: vault-lab-control ACTION SLOT [ARG...]"
readonly requested_action="$1"
readonly requested_slot="$2"
shift 2
require_slot "$requested_slot"

case "$requested_action" in
  prepare)
    (( $# == 0 )) || die "prepare accepts no extra arguments"
    prepare_slot "$requested_slot"
    ;;
  start)
    (( $# == 0 )) || die "start accepts no extra arguments"
    require_slot_filesystem "$requested_slot"
    [[ -s "${RUNTIME_ROOT}/${requested_slot}/vault.hcl" ]] || die "slot config is missing"
    systemctl start "vault-lab@${requested_slot}.service"
    ;;
  stop)
    (( $# == 0 )) || die "stop accepts no extra arguments"
    acquire_slot_lock "$requested_slot"
    stop_scoped_units "$requested_slot"
    systemctl stop "vault-lab@${requested_slot}.service"
    ;;
  status)
    (( $# == 0 )) || die "status accepts no extra arguments"
    systemctl is-active "vault-lab@${requested_slot}.service"
    ;;
  service-pid)
    (( $# == 0 )) || die "service-pid accepts no extra arguments"
    [[ "$(systemctl show -p ActiveState --value "vault-lab@${requested_slot}.service")" \
        == "active" ]] || die "slot service is not active"
    service_pid="$(
      systemctl show -p MainPID --value "vault-lab@${requested_slot}.service"
    )"
    [[ "$service_pid" =~ ^[0-9]+$ && "$service_pid" -gt 1 ]] \
      || die "slot service PID is invalid"
    printf '%s\n' "$service_pid"
    ;;
  terminal)
    (( $# == 2 )) || die "terminal requires a session binding and lifetime"
    [[ "$1" =~ $SESSION_ID_PATTERN ]] || die "invalid terminal session binding"
    [[ "$2" =~ ^[0-9]+$ ]] || die "invalid terminal lifetime"
    (( 10#$2 >= 1 && 10#$2 <= 86400 )) || die "terminal lifetime out of range"
    run_terminal "$requested_slot" "$1" "$((10#$2))"
    ;;
  terminal-count)
    (( $# == 0 )) || die "terminal-count accepts no extra arguments"
    terminal_count "$requested_slot"
    ;;
  learner-port-probe)
    (( $# == 0 )) || die "learner-port-probe accepts no extra arguments"
    probe_learner_port "$requested_slot"
    ;;
  learner-signal-probe)
    (( $# == 0 )) || die "learner-signal-probe accepts no extra arguments"
    probe_learner_signal "$requested_slot"
    ;;
  extend-guard)
    (( $# == 2 )) || die "extend-guard requires session binding and expiry"
    write_expiry_guard "$requested_slot" "$1" "$2"
    ;;
  reap)
    (( $# == 2 )) || die "reap requires session binding and expiry"
    reap_slot "$requested_slot" "$1" "$2"
    ;;
  command)
    (( $# >= 5 )) \
      || die "command requires session, operation, step, separator, and argv"
    run_command "$requested_slot" "$@"
    ;;
  *)
    die "unsupported action"
    ;;
esac
