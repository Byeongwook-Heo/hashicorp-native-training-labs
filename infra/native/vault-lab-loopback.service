[Unit]
Description=Provision exact loopback addresses for native Vault lab slots
Documentation=https://developer.hashicorp.com/vault/docs
After=local-fs.target vault-lab-storage.target
Requires=vault-lab-storage.target
Before=vault-lab-web.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/vault-lab-loopback
RemainAfterExit=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
